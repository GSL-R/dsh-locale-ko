{
  "name": "dsh-locale-ko",
  "version": "0.1.0",
  "description": "Korean (ko) language pack for the DeepSeek Harness web GUI",
  "license": "MIT",
  "author": "GSL-R",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "locale",
    "language-pack",
    "korean",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSL-R/dsh-locale-ko.git"
  },
  "homepage": "https://github.com/GSL-R/dsh-locale-ko#readme",
  "bugs": {
    "url": "https://github.com/GSL-R/dsh-locale-ko/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "extract": "node scripts/extract-locale.mjs",
    "drift": "node scripts/drift.mjs",
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs && node scripts/check.mjs",
    "verify": "node scripts/build-client.mjs --strict && node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
